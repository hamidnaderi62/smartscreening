# Public host. Caddy obtains HTTPS automatically for a real DNS name.
APP_DOMAIN=screening.example.com

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=screening.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://screening.example.com
SMARTSCREENING_PUBLIC_URL=https://screening.example.com

DJANGO_DB_NAME=smartscreening
DJANGO_DB_USER=smartscreening
DJANGO_DB_PASSWORD=replace-with-a-strong-database-password
DJANGO_DB_PORT=5432

# Kavenegar SMS integration
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_BASE_URL=https://api.kavenegar.com
KAVENEGAR_TIMEOUT=15
FOLLOWUP_INTERVAL_SECONDS=300

# Optional external recommendation service
SMARTLIFE_BASE_URL=http://host.docker.internal:8001
